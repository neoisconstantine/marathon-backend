<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PersonMapper">
    
    <resultMap type="Person" id="PersonResult">
    	<id     property="id"             column="id"              />
        <result property="openid"         column="openid"          />
        <result property="name"           column="name"            />
        <result property="gender"         column="gender"          />
        <result property="birthDate"      column="birth_date"      />
        <result property="phone"          column="phone"           />
        <result property="idCard"         column="id_card"         />
        <result property="emergencyName"  column="emergency_name"  />
        <result property="emergencyPhone" column="emergency_phone" />
        <result property="status"         column="status"          />
        <result property="createTime"     column="create_time"     />
        <result property="updateTime"     column="update_time"     />
        <result property="eventNames"     column="event_names"     />
    </resultMap>
    
    <sql id="selectPersonVo">
        select p.id, p.openid, p.name, p.gender, p.birth_date, p.phone, p.id_card, p.emergency_name, p.emergency_phone, p.status, p.create_time, p.update_time,
               (select group_concat(e.name separator '、') from registration r left join `event` e on r.event_id = e.id where r.person_id = p.id and r.status &lt;&gt; 2) as event_names
		from person p
    </sql>
    
    <select id="selectPersonById" parameterType="Long" resultMap="PersonResult">
        <include refid="selectPersonVo"/>
        where p.id = #{id}
    </select>
    
    <select id="selectPersonByOpenid" parameterType="String" resultMap="PersonResult">
        <include refid="selectPersonVo"/>
        where p.openid = #{openid}
    </select>
    
    <select id="selectPersonList" parameterType="Person" resultMap="PersonResult">
        <include refid="selectPersonVo"/>
        <where>  
			<if test="openid != null and openid != ''">
				AND p.openid = #{openid}
			</if>
			<if test="name != null and name != ''">
				AND p.name like concat('%', #{name}, '%')
			</if>
			<if test="gender != null">
				AND p.gender = #{gender}
			</if>
			<if test="phone != null and phone != ''">
				AND p.phone like concat('%', #{phone}, '%')
			</if>
			<if test="idCard != null and idCard != ''">
				AND p.id_card = #{idCard}
			</if>
			<if test="status != null">
				AND p.status = #{status}
			</if>
		</where>
        order by p.id desc
    </select>
    
    <insert id="insertPerson" parameterType="Person" useGeneratedKeys="true" keyProperty="id">
        insert into person (
			<if test="openid != null and openid != ''">openid,</if>
			<if test="name != null and name != ''">name,</if>
			<if test="gender != null">gender,</if>
			<if test="birthDate != null">birth_date,</if>
			<if test="phone != null and phone != ''">phone,</if>
			<if test="idCard != null and idCard != ''">id_card,</if>
			<if test="emergencyName != null and emergencyName != ''">emergency_name,</if>
			<if test="emergencyPhone != null and emergencyPhone != ''">emergency_phone,</if>
			<if test="status != null">status,</if>
 			create_time
        )values(
			<if test="openid != null and openid != ''">#{openid},</if>
			<if test="name != null and name != ''">#{name},</if>
			<if test="gender != null">#{gender},</if>
			<if test="birthDate != null">#{birthDate},</if>
			<if test="phone != null and phone != ''">#{phone},</if>
			<if test="idCard != null and idCard != ''">#{idCard},</if>
			<if test="emergencyName != null and emergencyName != ''">#{emergencyName},</if>
			<if test="emergencyPhone != null and emergencyPhone != ''">#{emergencyPhone},</if>
			<if test="status != null">#{status},</if>
 			sysdate()
		)
    </insert>
	 
    <update id="updatePerson" parameterType="Person">
        update person 
        <set>
            <if test="openid != null and openid != ''">openid = #{openid},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthDate != null">birth_date = #{birthDate},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="idCard != null">id_card = #{idCard},</if>
            <if test="emergencyName != null">emergency_name = #{emergencyName},</if>
            <if test="emergencyPhone != null">emergency_phone = #{emergencyPhone},</if>
            <if test="status != null">status = #{status},</if>
 			update_time = sysdate()
        </set>
        where id = #{id}
    </update>
	
    <delete id="deletePersonById" parameterType="Long">
        delete from person where id = #{id}
    </delete>
    
    <delete id="deletePersonByIds" parameterType="Long">
        delete from person where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
        	#{id}
        </foreach>
    </delete>
    
</mapper>
